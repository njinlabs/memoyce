{
  // Build untuk npm: hanya src/, keluaran ESM + deklarasi di dist/.
  // Sumber menulis impor relatif dengan ".ts"; rewriteRelativeImportExtensions mengubahnya jadi ".js"
  // pada keluaran (JS dan .d.ts), sehingga valid di Node ESM tanpa bundler.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": false,
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src"]
}
