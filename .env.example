# Dipakai aplikasi uji examples/cli (library sendiri tidak membaca environment variable).
# Bun memuat file .env otomatis. Salin file ini menjadi .env lalu isi kuncinya.

# Wajib: percakapan lewat Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Opsional: nama model Gemini (bawaan gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.8-flash

# Embedding untuk pencarian makna. Bawaan: openai bila OPENAI_API_KEY ada, selain itu gemini
# (memakai GEMINI_API_KEY yang sama). Isi "none" untuk mematikan vektor.
# EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Opsional: kalibrasi ambang "tidak tahu" (lihat README examples/cli)
# Hasil kalibrasi gemini-embedding-001@768 (bun run eval --sweep): 0.76 / 0.5. Bergantung model.
# MIN_SIMILARITY=0.76
# MIN_KEYWORD_COVERAGE=0.5
